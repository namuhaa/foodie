# Foodie Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example for local MongoDB: mongodb://localhost:27017/foodie_db
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/foodie_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/foodie_db
